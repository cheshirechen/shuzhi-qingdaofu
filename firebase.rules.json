{
  "rules": {
    "demoRooms": {
      "$session": {
        ".read": "auth != null && $session.matches(/^[A-Z0-9-]{1,24}$/)",
        ".write": "auth != null && $session.matches(/^[A-Z0-9-]{1,24}$/)",
        ".validate": "newData.hasChildren(['session','stage','revision','eventSeq','updatedAt','sourceRole']) && newData.child('session').val() === $session && newData.child('stage').val().matches(/^(idle|detected|analyzing|dispatched|accepted|completed)$/) && newData.child('revision').isNumber() && newData.child('eventSeq').isNumber() && newData.child('updatedAt').isNumber() && newData.child('sourceRole').val().matches(/^(system|dashboard|detector|worker)$/)"
      }
    }
  }
}
